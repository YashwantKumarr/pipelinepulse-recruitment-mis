# Copy to .env and fill in only what you use. Placeholders only: never commit real values.
APP_NAME=TalentFlow AI
APP_ENV=development
DATABASE_URL=sqlite:///./talentflow.db
UPLOAD_DIR=data/uploads

# rules = deterministic baseline only (no AI, no network). ollama = local model. claude = optional paid API.
AI_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_TIMEOUT_SECONDS=30

MAX_RESUME_SIZE_MB=5
FEEDBACK_SLA_HOURS=72

# Webhooks are disabled by default. If enabled, the secret must be at least 16 characters.
ENABLE_N8N_WEBHOOKS=false
N8N_SHARED_SECRET=
